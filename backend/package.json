  "description": "Kartavya (SIH26101) backend — competency engine, recommendations, sessions/QR, proctoring, dashboards.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
