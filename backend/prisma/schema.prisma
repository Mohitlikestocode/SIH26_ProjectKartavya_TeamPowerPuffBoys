// Kartavya (SIH26101) backend — Prisma schema.
// Models land in Phase 1 (see prompt.md build order): User, Role, CompetencyDomain,
// SubSkill, RoleCompetencyRequirement, UserCompetencyScore, Assessment, Attempt,
// ViolationEvent, Session, Course, TrainingProgramme.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Assessment module / Phase 1: PDF -> MCQ generation pipeline ---

enum DocumentStatus {
  pending
  processing
  processed
  failed
}

enum QuestionStatus {
  draft
  approved
  rejected
}

model SourceDocument {
  id               String         @id @default(cuid())
  originalFilename String
  mimeType         String
  storagePath      String
  status           DocumentStatus @default(pending)
  pageCount        Int?
  // Pages/slides that had no extractable text and were routed through OCR fallback.
  ocrFlaggedPages  Int[]          @default([])
  failureReason    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  chunks    Chunk[]
  questions Question[]
}

model Chunk {
  id         String   @id @default(cuid())
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sequence   Int
  heading    String?
  text       String
  createdAt  DateTime @default(now())

  questions Question[]

  @@unique([documentId, sequence])
}

model Question {
  id               String          @id @default(cuid())
  // Nullable: manually-created questions (Phase 2) have no source chunk.
  sourceDocumentId String?
  sourceDocument   SourceDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  chunkId          String?
  chunk            Chunk?          @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  chunkText        String?
  question         String
  options          String[]
  isNegatedStem    Boolean         @default(false)
  correctOption    Int
  // OptionExplanation[4], index-aligned to `options`:
  // [{ optionIndex, isTrueStatement, isCorrect, text }, ...].
  // isCorrect/correctOption are derived in code (see src/lib/mcq/deriveCorrectOption.ts) from
  // isTrueStatement + isNegatedStem — never trusted directly from the model or an admin edit.
  // Rows created before this field existed on the wire don't have isTrueStatement populated.
  explanations     Json
  // Stub fields — populated by a later competency-ontology module.
  domain           String          @default("TBD")
  skill            String          @default("TBD")
  status           QuestionStatus  @default(draft)
  createdAt        DateTime        @default(now())

  editLogs            QuestionEditLog[]
  assessmentQuestions AssessmentQuestion[]
  attemptAnswers      AttemptAnswer[]

  @@index([sourceDocumentId])
  @@index([chunkId])
  @@index([status])
  @@index([isNegatedStem])
}

// Audit trail for admin edits to a question (AI-generated or manual) — who changed what, when.
// `editedBy` is a placeholder identity string (see src/middleware/adminIdentity.ts) until a real
// auth/user model exists; it should become a foreign key to that model once Auth is built.
model QuestionEditLog {
  id           String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  editedBy     String
  editedAt     DateTime @default(now())
  fieldChanged String
  oldValue     String?
  newValue     String?

  @@index([questionId])
}

// Audit trail for generations rejected by the validation layer — never silently discarded.
model GenerationRejection {
  id        String   @id @default(cuid())
  chunkId   String
  reason    String
  rawOutput String
  createdAt DateTime @default(now())

  @@index([chunkId])
}

// --- Assessment module / Phase 3: test assembly, delivery, attempts, scoring ---

// Mirrors AssessmentType from src/types/domains.ts ("mcq" | "simulation" | "diagnostic") — kept
// as a plain string rather than a Prisma enum since it's a cross-module type; everything Phase 3
// builds sets this to "mcq". `purpose` (below) is what actually distinguishes the four Phase 3
// test types, since AssessmentType's own "diagnostic" value doesn't have room for
// practice/graded/self_generated alongside it.
enum AssessmentPurpose {
  diagnostic
  practice
  graded
  self_generated
}

model Assessment {
  id               String            @id @default(cuid())
  type             String            @default("mcq")
  purpose          AssessmentPurpose
  title            String
  // null = untimed (practice/self-generated/diagnostic); set for graded/final.
  timeLimitMinutes Int?
  // Percent required to pass; null = ungraded. Only "graded" purpose sets this in practice.
  passingThreshold Int?
  // Target question count at assembly time (the actual assembled count may be lower if the
  // eligible question bank for the given criteria is smaller than requested).
  questionCount    Int
  // The assembly criteria used (domain/skill/scope/etc) — for traceability/debugging only, never
  // re-parsed by application logic.
  criteria         Json?
  // Placeholder identity of whoever triggered assembly (see src/middleware/userIdentity.ts);
  // null for system-assembled diagnostics with no specific initiating user.
  createdBy        String?
  createdAt        DateTime          @default(now())

  assessmentQuestions AssessmentQuestion[]
  attempts            Attempt[]
}

// Join table: the fixed set of questions selected for one Assessment, in delivery order.
model AssessmentQuestion {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sequence     Int

  @@unique([assessmentId, questionId])
  @@unique([assessmentId, sequence])
  @@index([questionId])
}

// Mirrors AttemptStatus from src/types/domains.ts.
enum AttemptStatus {
  in_progress
  submitted
  kicked
  expired
}

model Attempt {
  id             String        @id @default(cuid())
  assessmentId   String
  assessment     Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  // Placeholder identity string (see src/middleware/userIdentity.ts) — same pattern as Phase 2's
  // editedBy until a real User model/auth exists.
  userId         String
  status         AttemptStatus @default(in_progress)
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  // Percent correct, set at submission; null while in_progress.
  score          Float?
  // Only meaningful when assessment.passingThreshold is set; null otherwise.
  passed         Boolean?
  violationCount Int           @default(0)

  answers         AttemptAnswer[]
  violationEvents AttemptViolationEvent[]

  @@index([assessmentId])
  @@index([userId])
}

model AttemptAnswer {
  id                  String   @id @default(cuid())
  attemptId           String
  attempt             Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId          String
  question            Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIndex Int
  // Computed against the question's derived correctOption at submission time; null until then.
  isCorrect           Boolean?
  answeredAt          DateTime @default(now())

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// Basic anti-cheat log for graded/final attempts only. `type` mirrors ViolationEventDTO.type from
// src/types/domains.ts, stored as free text rather than forking a Prisma enum from it.
model AttemptViolationEvent {
  id         String   @id @default(cuid())
  attemptId  String
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type       String
  occurredAt DateTime @default(now())

  @@index([attemptId])
}
