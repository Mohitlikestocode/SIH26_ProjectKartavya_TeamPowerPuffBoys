NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kartavya?schema=public"
# Only needed with a pooled connection (e.g. Supabase's pgbouncer URL on port 6543) — schema.prisma
# requires it for that case (migrations need a real session, which the pooler doesn't give). Point
# this at the same database's DIRECT (unpooled, port 5432) connection string. Not needed at all for
# a plain local Postgres like the DATABASE_URL above.
DIRECT_URL=""

JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

SESSION_JOIN_TOKEN_SECRET="change-me-too"
SESSION_JOIN_TOKEN_TTL_MINUTES=120

SARVAM_API_KEY=""
SARVAM_ENABLED="false"
SARVAM_BASE_URL="https://api.sarvam.ai/v1"
SARVAM_MODEL="sarvam-105b"

UPLOAD_DIR="uploads"

CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"
