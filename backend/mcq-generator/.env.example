# Required unless you run with --mock.
GROQ_API_KEY=""

# Optional. Must be a model with strict structured-output support —
# openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b at time of writing.
# Other models silently degrade to best-effort JSON; the Zod parse in
# src/llm.ts catches the fallout, but you will see more failed batches.
MCQ_MODEL="openai/gpt-oss-120b"
