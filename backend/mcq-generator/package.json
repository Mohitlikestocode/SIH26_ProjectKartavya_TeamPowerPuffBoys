{
  "name": "kartavya-mcq-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Case-based MCQ generator for Kartavya (SIH26101) \u2014 standalone MVP, no server, no database.",
  "scripts": {
    "generate": "tsx src/cli.ts",
    "demo:broad": "tsx src/cli.ts --source samples/sampling-module.txt --skills domain:Statistical --stage broad --mock",
    "demo:specific": "tsx src/cli.ts --source samples/sampling-module.txt --skills Sampling --stage specific --mock",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
